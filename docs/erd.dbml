// Draft ERD — Bushcraft Tools (Milestone 1)
// Import at https://dbdiagram.io if you need to edit the diagram.

Table users {
  id int [pk, increment]
  email varchar [unique, not null]
  password_hash varchar [not null]
  display_name varchar [not null]
  role varchar [not null, note: 'user | admin']
  created_at datetime
}

Table categories {
  id int [pk, increment]
  name varchar [not null]
  slug varchar [unique, not null]
}

Table tools {
  id int [pk, increment]
  category_id int [not null, ref: > categories.id]
  name varchar [not null]
  brand varchar
  description text
  price decimal
  stock int
}

Table reviews {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  tool_id int [not null, ref: > tools.id]
  rating int [not null, note: '1-5']
  comment text
  created_at datetime
}

Table favorites {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  tool_id int [not null, ref: > tools.id]
  created_at datetime
}

// Unique (user_id, tool_id) on favorites
