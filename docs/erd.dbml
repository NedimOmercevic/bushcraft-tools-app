// Bushcraft Tools ERD (Milestone 2)
// Import at https://dbdiagram.io if you need to edit the diagram.

Table users {
  id int [pk, increment]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  display_name varchar(100) [not null]
  role varchar [not null, note: 'ENUM user | admin']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table categories {
  id int [pk, increment]
  name varchar(100) [not null]
  slug varchar(100) [unique, not null]
}

Table tools {
  id int [pk, increment]
  category_id int [not null, ref: > categories.id]
  name varchar(150) [not null]
  brand varchar(100)
  description text
  price decimal(10,2) [not null]
  stock int [not null, default: 0]
}

Table reviews {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  tool_id int [not null, ref: > tools.id]
  rating int [not null, note: 'CHECK 1-5']
  comment text
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (user_id, tool_id) [unique]
  }
}

Table favorites {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  tool_id int [not null, ref: > tools.id]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (user_id, tool_id) [unique]
  }
}
